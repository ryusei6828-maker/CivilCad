<Window x:Class="CivilCad.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:CivilCad.App.Settings"
        Title="設定" Width="620" Height="640" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <s:IconKeyToImageConverter x:Key="IconImage"/>
    </Window.Resources>
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock x:Name="StatusText" Foreground="#FF0066CC" TextWrapping="Wrap" MinHeight="18" Margin="0,0,0,8"/>
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="初期値に戻す" Width="110" Click="Reset_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="OK" Width="90" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
                    <Button Content="キャンセル" Width="90" IsCancel="True"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <TabControl>
            <TabItem Header="キー割り当て">
                <DockPanel Margin="6">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8">
                        「割り当てキー」欄をクリックして、割り当てたいキーを押してください (Ctrl / Shift / Alt との組み合わせも可)。
                        <LineBreak/>Backspace / Delete で割り当てを解除します。他のコマンドで使っているキーを押すと付け替えます。
                        <LineBreak/><Run Foreground="Gray">※ 英字キー単独 (例: E) は、コマンド欄が空のときだけ働きます。数字キーは座標入力と重なるため、F キーか Ctrl 等との組み合わせがおすすめです。
                        日本語入力 (IME) がオンのときは英字キー単独は働きません。</Run>
                    </TextBlock>
                    <DataGrid x:Name="BindingGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserSortColumns="False" HeadersVisibility="Column" SelectionMode="Single"
                              GridLinesVisibility="Horizontal" RowHeight="30">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="34" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding IconKey, Converter={StaticResource IconImage}}" Width="20" Height="20"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="コマンド" Binding="{Binding Name}" Width="150" IsReadOnly="True"/>
                            <DataGridTextColumn Header="入力名" Binding="{Binding Code}" Width="60" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="割り当てキー" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="解除" Padding="8,0" Margin="4,2,0,2" Click="Clear_Click"/>
                                            <TextBox Text="{Binding Key, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                                     VerticalContentAlignment="Center" FontFamily="Consolas" FontWeight="Bold"
                                                     Cursor="Hand" ToolTip="クリックしてキーを押す"
                                                     PreviewKeyDown="KeyBox_PreviewKeyDown" GotKeyboardFocus="KeyBox_GotFocus"
                                                     LostKeyboardFocus="KeyBox_LostFocus"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="備考" Binding="{Binding Note}" Width="170" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="Gray"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="表示">
                <StackPanel Margin="10">
                    <TextBlock Text="背景色" FontWeight="Bold" Margin="0,0,0,6"/>
                    <ItemsControl x:Name="BackgroundChoices">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="色コード (#RRGGBB)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="BackgroundBox" Width="90" VerticalContentAlignment="Center" FontFamily="Consolas"
                                 TextChanged="BackgroundBox_TextChanged" ToolTip="例: #1E1E1E (既定)、#FFFFFF (白)"/>
                        <Border x:Name="BackgroundPreview" Width="60" Height="22" Margin="8,0,0,0" BorderBrush="Gray" BorderThickness="1"/>
                    </StackPanel>
                    <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="明るい背景では白い線・文字を黒で、暗い背景では黒い線を白で表示します (図形の色は変わりません)。"/>

                    <TextBlock Text="グリッド" FontWeight="Bold" Margin="0,18,0,6"/>
                    <CheckBox x:Name="GridVisibleCheck" Content="グリッドを表示する (F7 / コマンド GR でも切り替え)"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="間隔 (m)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="GridSpacingBox" Width="100" IsEditable="True"
                                  ToolTip="図面上の m。「自動」は拡大率に合わせて 1・2・5・10… m から選ぶ"/>
                        <TextBlock Foreground="Gray" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap" Width="330"
                                   Text="「自動」は拡大率に合わせて変わります。指定した間隔が画面で細かすぎるときは 10 倍ずつ間引きます。5 本ごとに少し濃い線。"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
