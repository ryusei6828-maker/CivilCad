<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CivilCad.Core\CivilCad.Core.csproj" />
    <ProjectReference Include="..\CivilCad.Alignment\CivilCad.Alignment.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ACadSharp" Version="3.8.0" />
    <PackageReference Include="netDxf.netstandard" Version="3.0.1" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>CivilCad</AssemblyName>
    <ApplicationIcon>civilcad.ico</ApplicationIcon>
    <Product>CivilCad</Product>
    <Version>0.12.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="civilcad.ico" />
  </ItemGroup>

  <!-- SkiaSharp のネイティブライブラリのデバッグ情報 (約 90MB) は配布物に要らない -->
  <Target Name="RemoveNativePdb" AfterTargets="Publish">
    <Delete Files="$(PublishDir)libSkiaSharp.pdb" />
  </Target>

</Project>
