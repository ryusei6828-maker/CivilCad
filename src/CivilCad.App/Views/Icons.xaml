    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <DrawingImage x:Key="IconCopy" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Brush="#CFE0F7" Pen="{StaticResource IcoInkPen}" Geometry="M3,3 H14 V15 H3 Z"/>
