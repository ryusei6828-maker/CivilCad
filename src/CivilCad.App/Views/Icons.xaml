<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">
    <!-- 24x24 のベクターアイコン。描画系は右上に鉛筆を重ねる -->

    <SolidColorBrush x:Key="IcoInk" Color="#2B2B2B" po:Freeze="True"/>
    <SolidColorBrush x:Key="IcoBlue" Color="#2F74D0" po:Freeze="True"/>
    <SolidColorBrush x:Key="IcoPencil" Color="#F2B233" po:Freeze="True"/>
    <SolidColorBrush x:Key="IcoPink" Color="#F28CA0" po:Freeze="True"/>
    <SolidColorBrush x:Key="IcoWhite" Color="#FFFFFF" po:Freeze="True"/>
    <Pen x:Key="IcoInkPen" Brush="#2B2B2B" Thickness="1.4" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" po:Freeze="True"/>
    <Pen x:Key="IcoInkThick" Brush="#2B2B2B" Thickness="2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" po:Freeze="True"/>
    <Pen x:Key="IcoBluePen" Brush="#2F74D0" Thickness="2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" po:Freeze="True"/>
    <Pen x:Key="IcoRoutePen" Brush="#E89B00" Thickness="3" StartLineCap="Round" EndLineCap="Round" po:Freeze="True"/>
    <RectangleGeometry x:Key="IcoFrame" Rect="0,0,24,24" po:Freeze="True"/>
    <StreamGeometry x:Key="PencilBody" po:Freeze="True">M19,2 L22,5 L13,14 L10,15 L11,12 Z M17,4 L20,7</StreamGeometry>
    <StreamGeometry x:Key="PencilTip" po:Freeze="True">M10,15 L10.7,12.9 L12.1,14.3 Z</StreamGeometry>

    <!-- ファイル・編集 -->
    <DrawingImage x:Key="IconNew" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Brush="{StaticResource IcoWhite}" Pen="{StaticResource IcoInkPen}" Geometry="M5,2 H14 L19,7 V22 H5 Z M14,2 V7 H19"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <DrawingImage x:Key="IconOpen" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Brush="#F5C542" Pen="{StaticResource IcoInkPen}" Geometry="M2,5 H9 L11,7 H21 V20 H2 Z"/>
        <GeometryDrawing Brush="#FADB7A" Pen="{StaticResource IcoInkPen}" Geometry="M2,20 L5,10 H23 L20,20 Z"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <DrawingImage x:Key="IconSave" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Brush="{StaticResource IcoBlue}" Pen="{StaticResource IcoInkPen}" Geometry="M3,3 H18 L21,6 V21 H3 Z"/>
        <GeometryDrawing Brush="{StaticResource IcoWhite}" Geometry="M7,3.7 H16 V9 H7 Z M6,13 H18 V20.3 H6 Z"/>
        <GeometryDrawing Brush="{StaticResource IcoInk}" Geometry="M13,4.5 H15 V8 H13 Z"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <DrawingImage x:Key="IconUndo" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Pen="{StaticResource IcoInkThick}" Geometry="M9,5 L4,10 L9,15 M4,10 H15 A5,5 0 0 1 15,20 H10"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <DrawingImage x:Key="IconRedo" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Pen="{StaticResource IcoInkThick}" Geometry="M15,5 L20,10 L15,15 M20,10 H9 A5,5 0 0 0 9,20 H14"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <!-- 作図 (鉛筆付き) -->
    <DrawingImage x:Key="IconLine" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Pen="{StaticResource IcoBluePen}" Geometry="M2,22 L10,15"/>
        <GeometryDrawing Brush="{StaticResource IcoPencil}" Pen="{StaticResource IcoInkPen}" Geometry="{StaticResource PencilBody}"/>
        <GeometryDrawing Brush="{StaticResource IcoInk}" Geometry="{StaticResource PencilTip}"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <DrawingImage x:Key="IconPolyline" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Pen="{StaticResource IcoBluePen}" Geometry="M2,22 L3.5,15 L7,20 L10,15"/>
        <GeometryDrawing Brush="{StaticResource IcoPencil}" Pen="{StaticResource IcoInkPen}" Geometry="{StaticResource PencilBody}"/>
        <GeometryDrawing Brush="{StaticResource IcoInk}" Geometry="{StaticResource PencilTip}"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <DrawingImage x:Key="IconHatch" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Pen="{StaticResource IcoBluePen}" Geometry="M2,13 L12,13 L12,23 L2,23 Z"/>
        <GeometryDrawing Pen="{StaticResource IcoBluePen}" Geometry="M2,17 L6,13 M2,21 L10,13 M4,23 L12,15 M8,23 L12,19"/>
        <GeometryDrawing Brush="{StaticResource IcoPencil}" Pen="{StaticResource IcoInkPen}" Geometry="{StaticResource PencilBody}"/>
        <GeometryDrawing Brush="{StaticResource IcoInk}" Geometry="{StaticResource PencilTip}"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <DrawingImage x:Key="IconCircle" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Pen="{StaticResource IcoBluePen}">
            <GeometryDrawing.Geometry><EllipseGeometry Center="7,17" RadiusX="5" RadiusY="5"/></GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="{StaticResource IcoPencil}" Pen="{StaticResource IcoInkPen}" Geometry="{StaticResource PencilBody}"/>
        <GeometryDrawing Brush="{StaticResource IcoInk}" Geometry="{StaticResource PencilTip}"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <DrawingImage x:Key="IconArc" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Pen="{StaticResource IcoBluePen}" Geometry="M2,22 A9,9 0 0 1 10,15"/>
        <GeometryDrawing Brush="{StaticResource IcoPencil}" Pen="{StaticResource IcoInkPen}" Geometry="{StaticResource PencilBody}"/>
        <GeometryDrawing Brush="{StaticResource IcoInk}" Geometry="{StaticResource PencilTip}"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <DrawingImage x:Key="IconText" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Pen="{StaticResource IcoBluePen}" Geometry="M1.5,22 L5,12 L8.5,22 M3,18.5 H7"/>
        <GeometryDrawing Brush="{StaticResource IcoPencil}" Pen="{StaticResource IcoInkPen}" Geometry="{StaticResource PencilBody}"/>
        <GeometryDrawing Brush="{StaticResource IcoInk}" Geometry="{StaticResource PencilTip}"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <!-- 図枠: 外枠 + 右下の表題欄 -->
    <DrawingImage x:Key="IconFrame" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Brush="{StaticResource IcoWhite}" Pen="{StaticResource IcoInkThick}" Geometry="M2,4 H22 V20 H2 Z"/>
        <GeometryDrawing Brush="#CFE0F7" Pen="{StaticResource IcoInkPen}" Geometry="M12,13 H22 V20 H12 Z"/>
        <GeometryDrawing Pen="{StaticResource IcoInkPen}" Geometry="M12,15.3 H22 M12,17.6 H22 M15,13 V20"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <!-- 縮尺: 三角スケール -->
    <DrawingImage x:Key="IconScale" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Brush="#FBE7A1" Pen="{StaticResource IcoInkPen}" Geometry="M2,18 L18,2 L22,6 L6,22 Z"/>
        <GeometryDrawing Pen="{StaticResource IcoInkPen}" Geometry="M6,14 L8,16 M9,11 L10.5,12.5 M12,8 L14,10 M15,5 L16.5,6.5"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <!-- レイヤ: 重なった板 -->
    <DrawingImage x:Key="IconLayers" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Brush="#9DBDE8" Pen="{StaticResource IcoInkPen}" Geometry="M2,16 L12,21 L22,16 L12,11 Z"/>
        <GeometryDrawing Brush="#CFE0F7" Pen="{StaticResource IcoInkPen}" Geometry="M2,12 L12,17 L22,12 L12,7 Z"/>
        <GeometryDrawing Brush="{StaticResource IcoWhite}" Pen="{StaticResource IcoInkPen}" Geometry="M2,8 L12,13 L22,8 L12,3 Z"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <!-- プロパティ: 項目の並んだ表 -->
    <DrawingImage x:Key="IconProperties" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Brush="{StaticResource IcoWhite}" Pen="{StaticResource IcoInkPen}" Geometry="M4,2 H20 V22 H4 Z"/>
        <GeometryDrawing Brush="{StaticResource IcoBlue}" Geometry="M6.5,6 H9 V8.5 H6.5 Z M6.5,11 H9 V13.5 H6.5 Z M6.5,16 H9 V18.5 H6.5 Z"/>
        <GeometryDrawing Pen="{StaticResource IcoInkPen}" Geometry="M11,7.2 H17.5 M11,12.2 H17.5 M11,17.2 H17.5"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <!-- 座標設定: X(北)・Y(東) の軸と基準点 -->
    <DrawingImage x:Key="IconCoord" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Pen="{StaticResource IcoInkThick}" Geometry="M4,21 V4 M4,21 H21 M1.5,6.5 L4,3.5 L6.5,6.5 M18.5,18.5 L21.5,21 L18.5,23.5"/>
        <GeometryDrawing Brush="#D9534F" Pen="{StaticResource IcoInkPen}">
            <GeometryDrawing.Geometry><EllipseGeometry Center="14,11" RadiusX="3" RadiusY="3"/></GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Pen="{StaticResource IcoInkPen}" Geometry="M14,6 V16 M9,11 H19"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <!-- 修正 -->
    <DrawingImage x:Key="IconMove" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Pen="{StaticResource IcoInkThick}"
                         Geometry="M12,2 V22 M2,12 H22 M9,5 L12,2 L15,5 M9,19 L12,22 L15,19 M5,9 L2,12 L5,15 M19,9 L22,12 L19,15"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <DrawingImage x:Key="IconCopy" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Brush="#CFE0F7" Pen="{StaticResource IcoInkPen}" Geometry="M3,3 H14 V15 H3 Z"/>
        <GeometryDrawing Brush="{StaticResource IcoWhite}" Pen="{StaticResource IcoInkPen}" Geometry="M9,9 H20 V21 H9 Z"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <DrawingImage x:Key="IconErase" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Brush="#DCE8F5" Geometry="M8,12 L12,8 L19,15 L15,19 Z"/>
        <GeometryDrawing Brush="{StaticResource IcoPink}" Geometry="M3,17 L8,12 L15,19 L13,21 H7 Z"/>
        <GeometryDrawing Pen="{StaticResource IcoInkPen}" Geometry="M3,17 L12,8 L19,15 L13,21 H7 Z M8,12 L15,19 M13,21 H22"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <!-- 表示・計測 -->
    <DrawingImage x:Key="IconZoomExtents" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Pen="{StaticResource IcoInkPen}" Geometry="M2,7 V2 H7 M17,2 H22 V7 M22,17 V22 H17 M7,22 H2 V17"/>
        <GeometryDrawing Brush="{StaticResource IcoWhite}" Pen="{StaticResource IcoInkThick}" Geometry="M15,15 L18.5,18.5">
        </GeometryDrawing>
        <GeometryDrawing Brush="#DCE8F5" Pen="{StaticResource IcoInkThick}">
            <GeometryDrawing.Geometry><EllipseGeometry Center="11,11" RadiusX="4.5" RadiusY="4.5"/></GeometryDrawing.Geometry>
        </GeometryDrawing>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <DrawingImage x:Key="IconDistance" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Brush="#FBE7A1" Pen="{StaticResource IcoInkPen}" Geometry="M1.5,8 H22.5 V16 H1.5 Z"/>
        <GeometryDrawing Pen="{StaticResource IcoInkPen}" Geometry="M5,8 V11 M8,8 V13 M11,8 V11 M14,8 V13 M17,8 V11 M20,8 V13"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <DrawingImage x:Key="IconArea" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Brush="#8C2F74D0" Pen="{StaticResource IcoBluePen}" Geometry="M3,19 L6,5 L16,3 L21,12 L14,21 Z"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <!-- 路線 -->
    <DrawingImage x:Key="IconRoute" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Pen="{StaticResource IcoRoutePen}" Geometry="M3,21 C11,21 11,4 21,4"/>
        <GeometryDrawing Pen="{StaticResource IcoInkPen}" Geometry="M6.5,17.5 L8.5,22.5 M10.5,10 L14,13.5 M15.5,2 L16.5,7.5"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <DrawingImage x:Key="IconStation" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Brush="#D9534F" Pen="{StaticResource IcoInkPen}"
                         Geometry="M12,2 C8,2 5,5 5,9 C5,14 12,22 12,22 C12,22 19,14 19,9 C19,5 16,2 12,2 Z"/>
        <GeometryDrawing Brush="{StaticResource IcoWhite}">
            <GeometryDrawing.Geometry><EllipseGeometry Center="12,9" RadiusX="2.6" RadiusY="2.6"/></GeometryDrawing.Geometry>
        </GeometryDrawing>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <!-- シートタブ右端の縮尺・座標系ボタン (暗い背景用) -->
    <Style x:Key="SheetInfoButton" TargetType="Button">
        <Setter Property="Foreground" Value="#FF9CDCFE"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FF3E3E42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ツールバーのボタン (アイコン + 小さい文字) -->
    <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
        <Setter Property="MinWidth" Value="46"/>
        <Setter Property="Padding" Value="3,2"/>
        <Setter Property="Margin" Value="1,0"/>
    </Style>
</ResourceDictionary>
