        <GeometryDrawing Pen="{StaticResource IcoInkThick}" Geometry="M2,12 L8,12 M16,12 L22,12"/>
        <GeometryDrawing Pen="{StaticResource IcoInkPen}" Geometry="M10,10 L14,14 M14,10 L10,14"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

