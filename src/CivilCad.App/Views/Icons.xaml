        <GeometryDrawing Pen="{StaticResource IcoBluePen}" Geometry="M4,20 L12,12 L19,19"/>
        <GeometryDrawing Pen="{StaticResource IcoInkThick}" Geometry="M15,4 A9,9 0 0 1 21,13 M18,11 L21,13 L22.5,9.5"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <DrawingImage x:Key="IconOffset" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
