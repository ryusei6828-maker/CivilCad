        <GeometryDrawing Pen="{StaticResource IcoBluePen}" Geometry="M7,22 L7,10 M7,19 L10,19 L10,22"/>
        <GeometryDrawing Brush="{StaticResource IcoPencil}" Pen="{StaticResource IcoInkPen}" Geometry="{StaticResource PencilBody}"/>
        <GeometryDrawing Brush="{StaticResource IcoInk}" Geometry="{StaticResource PencilTip}"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <DrawingImage x:Key="IconFill" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Brush="#FF7FB2E5" Pen="{StaticResource IcoBluePen}" Geometry="M2,22 L4,12 L12,13 L13,22 Z"/>
        <GeometryDrawing Brush="{StaticResource IcoPencil}" Pen="{StaticResource IcoInkPen}" Geometry="{StaticResource PencilBody}"/>
        <GeometryDrawing Brush="{StaticResource IcoInk}" Geometry="{StaticResource PencilTip}"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <DrawingImage x:Key="IconJoin" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Pen="{StaticResource IcoBluePen}" Geometry="M2,18 L8,8 L14,14 L21,5"/>
        <GeometryDrawing Brush="{StaticResource IcoInk}">
            <GeometryDrawing.Geometry><GeometryGroup>
                <EllipseGeometry Center="8,8" RadiusX="2" RadiusY="2"/>
                <EllipseGeometry Center="14,14" RadiusX="2" RadiusY="2"/>
            </GeometryGroup></GeometryDrawing.Geometry>
        </GeometryDrawing>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <DrawingImage x:Key="IconPreset" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Pen="{StaticResource IcoInkPen}">
            <GeometryDrawing.Geometry><EllipseGeometry Center="12,14" RadiusX="6" RadiusY="6"/></GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="{StaticResource IcoInk}" Geometry="M12,6 L9.5,20 L12,17 Z"/>
        <GeometryDrawing Pen="{StaticResource IcoInkPen}" Geometry="M12,6 L14.5,20 L12,17 Z"/>
        <GeometryDrawing Pen="{StaticResource IcoBluePen}" Geometry="M9.5,4.5 L9.5,0.5 L14.5,4.5 L14.5,0.5"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <DrawingImage x:Key="IconPresetAdd" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Pen="{StaticResource IcoInkPen}" Geometry="M3,15 L9,4 L15,15 Z"/>
        <GeometryDrawing Pen="{StaticResource IcoBluePen}">
