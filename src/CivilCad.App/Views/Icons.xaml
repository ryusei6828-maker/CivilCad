    <!-- シートタブ右端の縮尺・座標系ボタン (暗い背景用) -->
    <Style x:Key="SheetInfoButton" TargetType="Button">
        <Setter Property="Foreground" Value="#FF9CDCFE"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FF3E3E42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ツールバーのボタン (アイコン + 小さい文字) -->
    <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
        <Setter Property="MinWidth" Value="46"/>
        <Setter Property="Padding" Value="3,2"/>
        <Setter Property="Margin" Value="1,0"/>
    </Style>
</ResourceDictionary>
