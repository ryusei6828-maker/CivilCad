        <GeometryDrawing Pen="{StaticResource IcoInkPen}" Geometry="M10,12 L19,12 M15,8.5 L19,12 L15,15.5"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>


    <DrawingImage x:Key="IconErase" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
