<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">
    <!-- 24x24 のベクターアイコン。描画系は右上に鉛筆を重ねる -->

    <SolidColorBrush x:Key="IcoInk" Color="#2B2B2B" po:Freeze="True"/>
    <SolidColorBrush x:Key="IcoBlue" Color="#2F74D0" po:Freeze="True"/>
    <SolidColorBrush x:Key="IcoPencil" Color="#F2B233" po:Freeze="True"/>
    <SolidColorBrush x:Key="IcoPink" Color="#F28CA0" po:Freeze="True"/>
    <SolidColorBrush x:Key="IcoWhite" Color="#FFFFFF" po:Freeze="True"/>
    <Pen x:Key="IcoInkPen" Brush="#2B2B2B" Thickness="1.4" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" po:Freeze="True"/>
    <Pen x:Key="IcoInkThick" Brush="#2B2B2B" Thickness="2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" po:Freeze="True"/>
    <Pen x:Key="IcoBluePen" Brush="#2F74D0" Thickness="2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" po:Freeze="True"/>
    <Pen x:Key="IcoRoutePen" Brush="#E89B00" Thickness="3" StartLineCap="Round" EndLineCap="Round" po:Freeze="True"/>
    <RectangleGeometry x:Key="IcoFrame" Rect="0,0,24,24" po:Freeze="True"/>
    <StreamGeometry x:Key="PencilBody" po:Freeze="True">M19,2 L22,5 L13,14 L10,15 L11,12 Z M17,4 L20,7</StreamGeometry>
    <StreamGeometry x:Key="PencilTip" po:Freeze="True">M10,15 L10.7,12.9 L12.1,14.3 Z</StreamGeometry>

    <!-- ファイル・編集 -->
    <DrawingImage x:Key="IconSelect" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Brush="White" Pen="{StaticResource IcoInkPen}" Geometry="M7,3 L7,19 L10.6,15.6 L13.2,21.2 L15.6,20.1 L13,14.6 L18,14.6 Z"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <DrawingImage x:Key="IconNew" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Brush="{StaticResource IcoWhite}" Pen="{StaticResource IcoInkPen}" Geometry="M5,2 H14 L19,7 V22 H5 Z M14,2 V7 H19"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <DrawingImage x:Key="IconOpen" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Brush="#F5C542" Pen="{StaticResource IcoInkPen}" Geometry="M2,5 H9 L11,7 H21 V20 H2 Z"/>
        <GeometryDrawing Brush="#FADB7A" Pen="{StaticResource IcoInkPen}" Geometry="M2,20 L5,10 H23 L20,20 Z"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <DrawingImage x:Key="IconSave" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Brush="{StaticResource IcoBlue}" Pen="{StaticResource IcoInkPen}" Geometry="M3,3 H18 L21,6 V21 H3 Z"/>
        <GeometryDrawing Brush="{StaticResource IcoWhite}" Geometry="M7,3.7 H16 V9 H7 Z M6,13 H18 V20.3 H6 Z"/>
        <GeometryDrawing Brush="{StaticResource IcoInk}" Geometry="M13,4.5 H15 V8 H13 Z"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <DrawingImage x:Key="IconUndo" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Pen="{StaticResource IcoInkThick}" Geometry="M9,5 L4,10 L9,15 M4,10 H15 A5,5 0 0 1 15,20 H10"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <DrawingImage x:Key="IconRedo" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Pen="{StaticResource IcoInkThick}" Geometry="M15,5 L20,10 L15,15 M20,10 H9 A5,5 0 0 0 9,20 H14"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <!-- 作図 (鉛筆付き) -->
    <DrawingImage x:Key="IconLine" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Pen="{StaticResource IcoBluePen}" Geometry="M2,22 L10,15"/>
        <GeometryDrawing Brush="{StaticResource IcoPencil}" Pen="{StaticResource IcoInkPen}" Geometry="{StaticResource PencilBody}"/>
        <GeometryDrawing Brush="{StaticResource IcoInk}" Geometry="{StaticResource PencilTip}"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <DrawingImage x:Key="IconPolyline" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Pen="{StaticResource IcoBluePen}" Geometry="M2,22 L3.5,15 L7,20 L10,15"/>
        <GeometryDrawing Brush="{StaticResource IcoPencil}" Pen="{StaticResource IcoInkPen}" Geometry="{StaticResource PencilBody}"/>
        <GeometryDrawing Brush="{StaticResource IcoInk}" Geometry="{StaticResource PencilTip}"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <DrawingImage x:Key="IconHatch" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Pen="{StaticResource IcoBluePen}" Geometry="M2,13 L12,13 L12,23 L2,23 Z"/>
        <GeometryDrawing Pen="{StaticResource IcoBluePen}" Geometry="M2,17 L6,13 M2,21 L10,13 M4,23 L12,15 M8,23 L12,19"/>
        <GeometryDrawing Brush="{StaticResource IcoPencil}" Pen="{StaticResource IcoInkPen}" Geometry="{StaticResource PencilBody}"/>
        <GeometryDrawing Brush="{StaticResource IcoInk}" Geometry="{StaticResource PencilTip}"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <DrawingImage x:Key="IconPoints" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Brush="#FFE8F1FB" Pen="{StaticResource IcoInkPen}" Geometry="M3,3 L15,3 L19,7 L19,21 L3,21 Z"/>
        <GeometryDrawing Pen="{StaticResource IcoBluePen}">
            <GeometryDrawing.Geometry><GeometryGroup>
                <EllipseGeometry Center="7,9" RadiusX="1.6" RadiusY="1.6"/>
                <EllipseGeometry Center="14,12" RadiusX="1.6" RadiusY="1.6"/>
                <EllipseGeometry Center="9,17" RadiusX="1.6" RadiusY="1.6"/>
            </GeometryGroup></GeometryDrawing.Geometry>
        </GeometryDrawing>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <DrawingImage x:Key="IconImage" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Brush="#FFE8F1FB" Pen="{StaticResource IcoInkPen}" Geometry="M3,4 L21,4 L21,20 L3,20 Z"/>
        <GeometryDrawing Brush="#FF6FAF5F" Geometry="M4,19 L9,12 L13,16 L16,13 L20,19 Z"/>
        <GeometryDrawing Brush="#FFF0B429" Geometry="M15.5,8.5 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <DrawingImage x:Key="IconCrop" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Brush="#FFE8F1FB" Geometry="M7,7 L19,7 L19,17 L7,17 Z"/>
        <GeometryDrawing Brush="#FF6FAF5F" Geometry="M8,16 L12,11 L15,14 L18,16 Z"/>
        <GeometryDrawing Pen="{StaticResource IcoInkPen}" Geometry="M7,2 L7,17 L22,17 M2,7 L17,7 L17,22"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <DrawingImage x:Key="IconBringFront" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Brush="#FFD0D0D0" Pen="{StaticResource IcoInkPen}" Geometry="M3,3 L14,3 L14,14 L3,14 Z"/>
        <GeometryDrawing Brush="{StaticResource IcoBlue}" Pen="{StaticResource IcoInkPen}" Geometry="M9,9 L21,9 L21,21 L9,21 Z"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <DrawingImage x:Key="IconSendBack" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
        <GeometryDrawing Brush="{StaticResource IcoBlue}" Pen="{StaticResource IcoInkPen}" Geometry="M9,9 L21,9 L21,21 L9,21 Z"/>
        <GeometryDrawing Brush="#FFD0D0D0" Pen="{StaticResource IcoInkPen}" Geometry="M3,3 L14,3 L14,14 L3,14 Z"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <DrawingImage x:Key="IconPerpendicular" po:Freeze="True"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IcoFrame}"/>
