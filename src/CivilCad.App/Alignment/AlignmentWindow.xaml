<Window x:Class="CivilCad.App.Alignment.AlignmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="路線計算" Width="1000" Height="720"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="8">
        <!-- 路線の基本情報 -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock Text="計算方法" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <ComboBox x:Name="MethodBox" Width="90" Margin="0,0,12,0" SelectionChanged="MethodBox_SelectionChanged"
                      ToolTip="IP法: IP (交点) と R・A で決める。要素法: 始点・方向角と、直線・円曲線・クロソイドの要素を順に並べて決める (IP法から要素法への変換はできるが、戻せない)">
                <ComboBoxItem Content="IP法"/>
                <ComboBoxItem Content="要素法"/>
            </ComboBox>
            <TextBlock Text="路線名" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="NameBox" Width="120" Margin="0,0,12,0"/>
            <TextBlock Text="開始追加距離 (m)" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="StartBox" Width="80" Margin="0,0,12,0"/>
            <TextBlock Text="測点間隔 (m)" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="PitchBox" Width="60" Margin="0,0,12,0"/>
            <TextBlock x:Name="TextHeightLabel" Text="文字高 (mm)" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="TextHeightBox" Width="60"/>
        </WrapPanel>
        <!-- 幅 (路肩線・幅杭) -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock Text="幅 左 (m)" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="LeftWidthBox" Width="110" Margin="0,0,12,0" ToolTip="中心線から左の幅。カンマ区切りで複数 (例: 3.0, 5.5)。空なら作図しない"/>
            <TextBlock Text="右 (m)" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="RightWidthBox" Width="110" Margin="0,0,12,0" ToolTip="中心線から右の幅。カンマ区切りで複数 (例: 3.0, 5.5)"/>
            <CheckBox x:Name="ShoulderCheck" Content="路肩線 (幅ごとの平行線)" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <CheckBox x:Name="StakeCheck" Content="幅杭 (測点ごとに一番外の幅)" VerticalAlignment="Center"/>
        </WrapPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <TextBlock x:Name="ErrorText" Foreground="Firebrick" VerticalAlignment="Center" Margin="0,0,16,0" TextWrapping="Wrap" MaxWidth="600"/>
            <Button Content="計算" Width="90" Margin="0,0,8,0" Click="Compute_Click"/>
            <Button Content="作図して閉じる" Width="120" Margin="0,0,8,0" Click="Draw_Click" IsDefault="True"/>
            <Button Content="キャンセル" Width="90" IsCancel="True"/>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="3*"/>
            </Grid.RowDefinitions>

            <!-- 要素法の入力 (始点・方向角・要素表) -->
            <GroupBox x:Name="ElementBox" Visibility="Collapsed" Header="要素表  (始点から順に、直線・円曲線・クロソイドをつなぐ。座標は測量座標 X=北 / Y=東、R が空・0 は ∞)">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <TextBlock Text="始点名" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="StartNameBox" Width="60" Margin="0,0,10,0"/>
                        <TextBlock Text="X (北)" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="StartXBox" Width="100" Margin="0,0,10,0"/>
                        <TextBlock Text="Y (東)" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="StartYBox" Width="100" Margin="0,0,10,0"/>
                        <TextBlock Text="始点の方向角" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="StartDirBox" Width="130" ToolTip="北を 0 として時計回り。度の小数 (123.4567) か 度分秒 (123°45'06.7&quot;) で入れる"/>
                    </WrapPanel>
                    <StackPanel DockPanel.Dock="Right" Margin="6,0,0,0" Width="90">
                        <Button Content="行を挿入" Margin="0,0,0,4" Click="InsertElement_Click"/>
                        <Button Content="行を削除" Margin="0,0,0,4" Click="DeleteElement_Click"/>
                        <Button Content="XML 読込" Margin="0,0,0,4" Click="LoadXml_Click"
                                ToolTip="路線の LandXML (J-LandXML) を読み込みます。要素法の路線は要素表になります"/>
                        <Button Content="XML 出力" Margin="0,0,0,4" Click="SaveXml_Click"
                                ToolTip="計算した路線を LandXML (J-LandXML) に書き出します"/>
                    </StackPanel>
                    <DataGrid x:Name="ElementGrid" AutoGenerateColumns="False" CanUserAddRows="True" CanUserSortColumns="False"
                              HeadersVisibility="Column" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridComboBoxColumn Header="要素" x:Name="ElementKindColumn" SelectedItemBinding="{Binding Kind, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                            <DataGridTextColumn Header="延長 (m)" Binding="{Binding Length}" Width="*"/>
                            <DataGridTextColumn Header="始点 R" Binding="{Binding R1}" Width="*"/>
                            <DataGridTextColumn Header="終点 R" Binding="{Binding R2}" Width="*"/>
                            <DataGridComboBoxColumn Header="回転" x:Name="ElementTurnColumn" SelectedItemBinding="{Binding Turn, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                            <DataGridTextColumn Header="A" Binding="{Binding A, Mode=OneWay, StringFormat=F3}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="終点名" Binding="{Binding EndName}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>

            <!-- IP 入力表 -->
            <GroupBox x:Name="IpBox" Header="IP 表  (座標は測量座標 X=北 / Y=東、R=0 は曲線なし、A=0 はクロソイドなし)">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Margin="6,0,0,0" Width="90">
                        <Button Content="行を挿入" Margin="0,0,0,4" Click="InsertRow_Click"/>
                        <Button Content="行を削除" Margin="0,0,0,4" Click="DeleteRow_Click"/>
                        <Button Content="CSV 貼付" Margin="0,0,0,4" Click="PasteCsv_Click"
                                ToolTip="Excel 等からコピーした 名称,X,Y,R,A1,A2 の表を貼り付けます"/>
                        <Button Content="XML 読込" Margin="0,0,0,4" Click="LoadXml_Click"
                                ToolTip="路線の LandXML (J-LandXML) を読み込み、IP 表・路線名・開始追加距離・測点間隔を置き換えます"/>
                        <Button Content="XML 出力" Margin="0,0,0,4" Click="SaveXml_Click"
                                ToolTip="計算した路線 (平面線形・IP・測点間隔) を LandXML (J-LandXML) に書き出します"/>
                    </StackPanel>
                    <DataGrid x:Name="IpGrid" AutoGenerateColumns="False" CanUserAddRows="True" CanUserSortColumns="False"
                              HeadersVisibility="Column" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="80"/>
                            <DataGridTextColumn Header="X (北)" Binding="{Binding X, StringFormat=F3}" Width="*"/>
                            <DataGridTextColumn Header="Y (東)" Binding="{Binding Y, StringFormat=F3}" Width="*"/>
                            <DataGridTextColumn Header="R" Binding="{Binding R}" Width="90"/>
                            <DataGridTextColumn Header="A1 (入口)" Binding="{Binding A1}" Width="90"/>
                            <DataGridTextColumn Header="A2 (出口)" Binding="{Binding A2}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>

            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch"/>

            <!-- 計算結果 -->
            <TabControl Grid.Row="2">
                <TabItem Header="主要点">
                    <DataGrid x:Name="MainPointGrid" IsReadOnly="True" AutoGenerateColumns="True" HeadersVisibility="Column"/>
                </TabItem>
                <TabItem x:Name="CurveTab" Header="曲線諸元">
                    <DataGrid x:Name="CurveGrid" IsReadOnly="True" AutoGenerateColumns="True" HeadersVisibility="Column"/>
                </TabItem>
                <TabItem Header="中心線座標 (測点ごと)">
                    <DataGrid x:Name="StationGrid" IsReadOnly="True" AutoGenerateColumns="True" HeadersVisibility="Column"/>
                </TabItem>
                <TabItem Header="任意点計算">
                    <StackPanel Margin="8">
                        <TextBlock Text="測点と幅から座標を求めます (測点は No.3+12.5 / 3+12.5 / 追加距離 の形式、幅は右側が +)" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="測点" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="QueryStationBox" Width="120" Margin="0,0,12,0" Text="No.5"/>
                            <TextBlock Text="幅 (m)" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="QueryOffsetBox" Width="80" Margin="0,0,12,0" Text="0"/>
                            <Button Content="計算" Width="80" Click="Query_Click"/>
                        </StackPanel>
                        <TextBox x:Name="QueryResult" Margin="0,8,0,0" IsReadOnly="True" FontFamily="Consolas" Height="80"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
