<Window x:Class="CivilCad.App.Drawing.ScaleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="縮尺の設定" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="12">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="図面の縮尺   1 :" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="14"/>
            <ComboBox x:Name="ScaleBox" Width="120" IsEditable="True" FontSize="14" TextBoxBase.TextChanged="ScaleBox_TextChanged"/>
        </StackPanel>
        <TextBlock x:Name="InfoText" Margin="0,8,0,0" Foreground="Gray" TextWrapping="Wrap"/>
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="Gray"
                   Text="文字の高さ・図枠・路線の注記は、この縮尺で「用紙上の mm」から図面の寸法 (m) に換算されます。すでに描いた図形の大きさは変わりません。"/>
        <TextBlock x:Name="ErrorText" Foreground="Firebrick"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="90" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="キャンセル" Width="90" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
