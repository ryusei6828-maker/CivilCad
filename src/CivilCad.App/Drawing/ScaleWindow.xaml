<Window x:Class="CivilCad.App.Drawing.ScaleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="シートの縮尺" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="12">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="このシートの縮尺   1 :" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="14"/>
            <ComboBox x:Name="ScaleBox" Width="120" IsEditable="True" FontSize="14" TextBoxBase.TextChanged="ScaleBox_TextChanged"/>
        </StackPanel>
        <TextBlock x:Name="InfoText" Margin="0,8,0,0" Foreground="Gray" TextWrapping="Wrap"/>
        <CheckBox x:Name="KeepPaperCheck" Margin="0,10,0,0" IsChecked="True">
            <TextBlock TextWrapping="Wrap" Text="図枠・文字・記号を新しい縮尺に合わせる (用紙上の大きさを保つ。A3 の図枠なら 1:100 で 38m、1:250 で 95m)"/>
        </CheckBox>
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="Gray"
                   Text="図面は実寸 (m) で描いているので、線・円などの図形と計測の値は縮尺を変えても変わりません。縮尺は、印刷するときの大きさと、文字の高さ・図枠・記号など「用紙上の mm」で決まる物の換算に使います。"/>
        <TextBlock x:Name="ErrorText" Foreground="Firebrick"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="90" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="キャンセル" Width="90" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
