<Window x:Class="CivilCad.App.Drawing.ScaleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="シートの縮尺" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="12">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="このシートの縮尺   1 :" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="14"/>
            <ComboBox x:Name="ScaleBox" Width="120" IsEditable="True" FontSize="14" TextBoxBase.TextChanged="ScaleBox_TextChanged"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="縦の縮尺           1 :" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="14"/>
            <ComboBox x:Name="VerticalBox" Width="120" IsEditable="True" FontSize="14"
                      ToolTip="縦断図など、縦と横で縮尺が違うときに入れる (例: 横 1:1000・縦 1:100)。空なら横と同じ"/>
        </StackPanel>
        <TextBlock Margin="0,2,0,0" Foreground="Gray" TextWrapping="Wrap"
                   Text="縦断図など縦横で縮尺が違う図のときだけ入れます (空なら横と同じ)。図形はそのままで、距離・面積の計測と寸法の値で縦の長さを縦の縮尺に直します。"/>
        <TextBlock x:Name="InfoText" Margin="0,8,0,0" Foreground="Gray" TextWrapping="Wrap"/>
        <TextBlock Margin="0,10,0,2" Text="すでに描いた図形:"/>
        <RadioButton x:Name="KeepPaperRadio" GroupName="mode" Margin="0,2">
            <TextBlock TextWrapping="Wrap" Text="図面をそのまま (図寸固定・おすすめ): 画面の見た目は変わらず、図面全体が新しい縮尺の大きさになる。1:100 で 10m の線は 1:250 で 25m と測れる"/>
        </RadioButton>
        <RadioButton x:Name="KeepRealRadio" GroupName="mode" Margin="0,2">
            <TextBlock TextWrapping="Wrap" Text="実寸を保つ (実寸固定): 線などの長さ (計測の値) はそのまま。図枠だけ新しい縮尺の大きさにする。測量座標に合わせて描いた図面向け"/>
        </RadioButton>
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="Gray"
                   Text="計測の値は図面上の実寸です。文字の高さ・図枠・記号は「用紙上の mm」をこの縮尺で実寸に換算します。表題欄の縮尺の文字は新しい縮尺に書き換えます。"/>
        <TextBlock x:Name="ErrorText" Foreground="Firebrick"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="90" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="キャンセル" Width="90" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
